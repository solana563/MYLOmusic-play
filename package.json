{
  "name": "mylo-music",
  "version": "1.0.0",
  "description": "MYLO — Internet Radio, YouTube, and Local Music Super-App",
  "main": "index.html",
  "scripts": {
    "build": "node scripts/build-web.js",
    "build:android:debug": "./android/gradlew -p android assembleDebug",
    "build:android": "./android/gradlew -p android assembleRelease",
    "build:android:bundle": "./android/gradlew -p android bundleRelease",
    "open:ios": "open ios/App/App.xcodeproj"
  },
  "keywords": [
    "music",
    "radio",
    "youtube",
    "player",
    "local-first",
    "audio",
    "android",
    "ios"
  ],
  "author": "MYLO",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/cli": "^8.4.3",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@supabase/supabase-js": "^2.43.0",
    "jsmediatags": "^3.9.5"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
